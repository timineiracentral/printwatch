#!/usr/bin/env bash
# Pre-commit: bloqueia IPs/usuarios reais em arquivos staged.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$ROOT/scripts/check-no-secrets.ps1" -Staged
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -File "$ROOT/scripts/check-no-secrets.ps1" -Staged
else
  bash "$ROOT/scripts/check-no-secrets.sh" --staged
fi
