# PrintWatch — variáveis de ambiente (Fase 1)
#
# Copie este arquivo para .env antes de executar `docker compose up -d`:
#   cp .env.example .env
#
# IMPORTANTE: Nunca commite o arquivo .env — ele contém credenciais reais (D-19).
# Este arquivo usa apenas placeholders seguros para documentação.

# Rede permitida no CUPS — única faixa autorizada nesta fase (D-06, D-08)
# Não usar ranges genéricos 192.168/10/172 da SPEC; apenas a rede local do ambiente.
ALLOWED_NETWORK=REDACTED_IP/16

# Credenciais do administrador CUPS — substituir por valores reais no .env local (D-19)
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=changeme

# Impressora de teste — usada por scripts/setup-printer.sh (Plan 03)
# Ajuste TEST_PRINTER_URI para o IP real da impressora HP/Samsung na rede 192.0.2.50 (D-12)
TEST_PRINTER_NAME=test_printer
TEST_PRINTER_URI=ipp://192.0.2.50/ipp/print
# Driver IPP Everywhere (recomendado para HP/Samsung modernos)
# Fallback sem hardware: use TEST_PRINTER_DRIVER=cups-pdf e URI ipp://localhost/printers/cups-pdf
TEST_PRINTER_DRIVER=everywhere
