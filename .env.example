# PrintWatch — variáveis de ambiente (Fase 1)
#
# Copie este arquivo para .env antes de executar `docker compose up -d`:
#   cp .env.example .env
#
# IMPORTANTE: Nunca commite o arquivo .env — ele contém credenciais reais (D-19).
# Este arquivo usa apenas placeholders seguros para documentação.

# Rede permitida no CUPS — única faixa autorizada nesta fase (D-06, D-08)
# Não usar ranges genéricos 192.168/10/172 da SPEC; apenas a rede local do ambiente.
ALLOWED_NETWORK=REDACTED_IP/16

# Credenciais do administrador CUPS — substituir por valores reais no .env local (D-19)
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=changeme

# Impressora de teste — usada por scripts/setup-printer.sh (Plan 03)
# Ajuste TEST_PRINTER_URI para o IP real da impressora HP/Samsung (D-12)
TEST_PRINTER_NAME=test_printer
TEST_PRINTER_URI=ipp://<PRINTER_HOST>/ipp/print
# Driver IPP Everywhere (recomendado para HP/Samsung modernos)
# Fallback sem hardware: deixe URI placeholder — setup-printer.sh usa cups-pdf:/ automaticamente
TEST_PRINTER_DRIVER=everywhere

# Fase 2 — backend
DB_PATH=/app/data/printwatch.db
LOG_PATH=/var/log/cups/page_log
LOG_RETENTION_DAYS=90
ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://VM_HOST
API_TIMEZONE=America/Sao_Paulo

# Fase 5 — master data / migrations
# Default false: aplicar schema via `cd backend && alembic upgrade head` (não no watcher path)
RUN_MIGRATIONS_ON_STARTUP=false

# Fase 8 — fleet / SNMP (community real só no .env local, nunca commitar)
SNMP_COMMUNITY=public
FLEET_HEALTH_INTERVAL_SEC=900
FLEET_SNMP_INTERVAL_SEC=43200
CUPS_HOST=cups
CUPS_PORT=631

# Vazio = same-origin /api/v1 via nginx (D-40)
VITE_API_BASE_URL=
